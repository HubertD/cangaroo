<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>WaveformDialog</class>
 <widget class="QDialog" name="WaveformDialog">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>580</width><height>560</height></rect>
  </property>
  <property name="windowTitle">
   <string>Configure Signal Waveforms</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayoutMain">

   <!-- ── Signal list ──────────────────────────────────────── -->
   <item>
    <layout class="QHBoxLayout" name="hlSignal">
     <item>
      <widget class="QLabel" name="lblSignal">
       <property name="text"><string>Signal:</string></property>
       <property name="minimumWidth"><number>55</number></property>
       <property name="alignment"><set>Qt::AlignTop</set></property>
      </widget>
     </item>
     <item>
      <widget class="QListWidget" name="listSignals">
       <property name="maximumHeight"><number>110</number></property>
       <property name="alternatingRowColors"><bool>true</bool></property>
      </widget>
     </item>
    </layout>
   </item>

   <!-- ── Type selector ──────────────────────────────────── -->
   <item>
    <layout class="QHBoxLayout" name="hlType">
     <item>
      <widget class="QLabel" name="lblType">
       <property name="text"><string>Waveform:</string></property>
       <property name="minimumWidth"><number>75</number></property>
      </widget>
     </item>
     <item>
      <widget class="QComboBox" name="comboType">
       <item><property name="text"><string>  None (off)  </string></property></item>
       <item><property name="text"><string>  Square Wave  </string></property></item>
       <item><property name="text"><string>  Sine Wave    </string></property></item>
       <item><property name="text"><string>  Ramp (Sawtooth)  </string></property></item>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="lblUnit">
       <property name="text"><string></string></property>
       <property name="styleSheet"><string>color: #aaa; font-style: italic;</string></property>
      </widget>
     </item>
     <item>
      <spacer>
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
    </layout>
   </item>

   <!-- ── Stacked parameter pages ───────────────────────── -->
   <item>
    <widget class="QStackedWidget" name="stackedParams">

     <!-- Page 0 : None -->
     <widget class="QWidget" name="pageNone">
      <layout class="QVBoxLayout">
       <item>
        <widget class="QLabel" name="lblNoneHint">
         <property name="text">
          <string>No waveform active — signal keeps the static value set in the message data bytes.</string>
         </property>
         <property name="wordWrap"><bool>true</bool></property>
         <property name="alignment"><set>Qt::AlignCenter</set></property>
         <property name="styleSheet"><string>color: #888; font-style: italic; padding: 12px;</string></property>
        </widget>
       </item>
      </layout>
     </widget>

     <!-- Page 1 : Square -->
     <widget class="QWidget" name="pageSquare">
      <layout class="QVBoxLayout">
       <item>
        <widget class="QGroupBox" name="grpSquare">
         <property name="title"><string>Square Wave Parameters</string></property>
         <layout class="QFormLayout" name="formSquare">

          <item row="0" column="0">
           <widget class="QLabel"><property name="text"><string>High Value:</string></property></widget>
          </item>
          <item row="0" column="1">
           <widget class="QDoubleSpinBox" name="spinSqHigh">
            <property name="minimum"><double>-1e+07</double></property>
            <property name="maximum"><double>1e+07</double></property>
            <property name="decimals"><number>4</number></property>
            <property name="singleStep"><double>1.0</double></property>
            <property name="value"><double>1.0</double></property>
            <property name="toolTip"><string>Signal value while in the HIGH (ON) phase</string></property>
           </widget>
          </item>

          <item row="1" column="0">
           <widget class="QLabel"><property name="text"><string>Low Value:</string></property></widget>
          </item>
          <item row="1" column="1">
           <widget class="QDoubleSpinBox" name="spinSqLow">
            <property name="minimum"><double>-1e+07</double></property>
            <property name="maximum"><double>1e+07</double></property>
            <property name="decimals"><number>4</number></property>
            <property name="singleStep"><double>1.0</double></property>
            <property name="value"><double>0.0</double></property>
            <property name="toolTip"><string>Signal value while in the LOW (OFF) phase</string></property>
           </widget>
          </item>

          <item row="2" column="0">
           <widget class="QLabel"><property name="text"><string>TON (ms):</string></property></widget>
          </item>
          <item row="2" column="1">
           <layout class="QHBoxLayout">
            <item>
             <widget class="QDoubleSpinBox" name="spinSqTon">
              <property name="minimum"><double>1.0</double></property>
              <property name="maximum"><double>1e+08</double></property>
              <property name="decimals"><number>1</number></property>
              <property name="singleStep"><double>10.0</double></property>
              <property name="value"><double>500.0</double></property>
              <property name="toolTip"><string>Duration the signal stays at High Value (ON time)</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="lblTonHint">
              <property name="text"><string>← ON time</string></property>
              <property name="styleSheet"><string>color: #28a745; font-size: 10px;</string></property>
             </widget>
            </item>
           </layout>
          </item>

          <item row="3" column="0">
           <widget class="QLabel"><property name="text"><string>TOFF (ms):</string></property></widget>
          </item>
          <item row="3" column="1">
           <layout class="QHBoxLayout">
            <item>
             <widget class="QDoubleSpinBox" name="spinSqToff">
              <property name="minimum"><double>1.0</double></property>
              <property name="maximum"><double>1e+08</double></property>
              <property name="decimals"><number>1</number></property>
              <property name="singleStep"><double>10.0</double></property>
              <property name="value"><double>500.0</double></property>
              <property name="toolTip"><string>Duration the signal stays at Low Value (OFF time)</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="lblToffHint">
              <property name="text"><string>← OFF time</string></property>
              <property name="styleSheet"><string>color: #dc3545; font-size: 10px;</string></property>
             </widget>
            </item>
           </layout>
          </item>

          <item row="4" column="0">
           <widget class="QLabel"><property name="text"><string>Period (ms):</string></property></widget>
          </item>
          <item row="4" column="1">
           <widget class="QLabel" name="lblSqPeriod">
            <property name="text"><string>1000.0 ms  (TON + TOFF)</string></property>
            <property name="styleSheet"><string>color: #aaa; font-style: italic;</string></property>
           </widget>
          </item>

         </layout>
        </widget>
       </item>
      </layout>
     </widget>

     <!-- Page 2 : Sine -->
     <widget class="QWidget" name="pageSine">
      <layout class="QVBoxLayout">
       <item>
        <widget class="QGroupBox" name="grpSine">
         <property name="title"><string>Sine Wave Parameters</string></property>
         <layout class="QFormLayout" name="formSine">

          <item row="0" column="0">
           <widget class="QLabel"><property name="text"><string>Amplitude:</string></property></widget>
          </item>
          <item row="0" column="1">
           <layout class="QHBoxLayout">
            <item>
             <widget class="QDoubleSpinBox" name="spinSinAmp">
              <property name="minimum"><double>0.0</double></property>
              <property name="maximum"><double>1e+07</double></property>
              <property name="decimals"><number>4</number></property>
              <property name="singleStep"><double>1.0</double></property>
              <property name="value"><double>1.0</double></property>
              <property name="toolTip"><string>Half peak-to-peak deviation from the centre offset</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel">
              <property name="text"><string>← half peak-to-peak</string></property>
              <property name="styleSheet"><string>color: #aaa; font-size: 10px;</string></property>
             </widget>
            </item>
           </layout>
          </item>

          <item row="1" column="0">
           <widget class="QLabel"><property name="text"><string>Offset (DC):</string></property></widget>
          </item>
          <item row="1" column="1">
           <layout class="QHBoxLayout">
            <item>
             <widget class="QDoubleSpinBox" name="spinSinOffset">
              <property name="minimum"><double>-1e+07</double></property>
              <property name="maximum"><double>1e+07</double></property>
              <property name="decimals"><number>4</number></property>
              <property name="singleStep"><double>1.0</double></property>
              <property name="value"><double>0.0</double></property>
              <property name="toolTip"><string>DC centre value the sine oscillates around</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel">
              <property name="text"><string>← centre value</string></property>
              <property name="styleSheet"><string>color: #aaa; font-size: 10px;</string></property>
             </widget>
            </item>
           </layout>
          </item>

          <item row="2" column="0">
           <widget class="QLabel"><property name="text"><string>Period (ms):</string></property></widget>
          </item>
          <item row="2" column="1">
           <widget class="QDoubleSpinBox" name="spinSinPeriod">
            <property name="minimum"><double>1.0</double></property>
            <property name="maximum"><double>1e+08</double></property>
            <property name="decimals"><number>1</number></property>
            <property name="singleStep"><double>100.0</double></property>
            <property name="value"><double>1000.0</double></property>
            <property name="toolTip"><string>Duration of one complete cycle</string></property>
           </widget>
          </item>

          <item row="3" column="0">
           <widget class="QLabel"><property name="text"><string>Phase (°):</string></property></widget>
          </item>
          <item row="3" column="1">
           <widget class="QDoubleSpinBox" name="spinSinPhase">
            <property name="minimum"><double>-360.0</double></property>
            <property name="maximum"><double>360.0</double></property>
            <property name="decimals"><number>1</number></property>
            <property name="singleStep"><double>10.0</double></property>
            <property name="value"><double>0.0</double></property>
            <property name="toolTip"><string>Phase offset in degrees (0° = starts at mid-point rising)</string></property>
           </widget>
          </item>

         </layout>
        </widget>
       </item>
      </layout>
     </widget>

     <!-- Page 3 : Ramp -->
     <widget class="QWidget" name="pageRamp">
      <layout class="QVBoxLayout">
       <item>
        <widget class="QGroupBox" name="grpRamp">
         <property name="title"><string>Ramp (Sawtooth) Parameters</string></property>
         <layout class="QFormLayout" name="formRamp">

          <item row="0" column="0">
           <widget class="QLabel"><property name="text"><string>Start Value:</string></property></widget>
          </item>
          <item row="0" column="1">
           <layout class="QHBoxLayout">
            <item>
             <widget class="QDoubleSpinBox" name="spinRampStart">
              <property name="minimum"><double>-1e+07</double></property>
              <property name="maximum"><double>1e+07</double></property>
              <property name="decimals"><number>4</number></property>
              <property name="singleStep"><double>1.0</double></property>
              <property name="value"><double>0.0</double></property>
              <property name="toolTip"><string>Signal value at the start of each ramp cycle</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel">
              <property name="text"><string>← beginning of cycle</string></property>
              <property name="styleSheet"><string>color: #aaa; font-size: 10px;</string></property>
             </widget>
            </item>
           </layout>
          </item>

          <item row="1" column="0">
           <widget class="QLabel"><property name="text"><string>End Value:</string></property></widget>
          </item>
          <item row="1" column="1">
           <layout class="QHBoxLayout">
            <item>
             <widget class="QDoubleSpinBox" name="spinRampEnd">
              <property name="minimum"><double>-1e+07</double></property>
              <property name="maximum"><double>1e+07</double></property>
              <property name="decimals"><number>4</number></property>
              <property name="singleStep"><double>1.0</double></property>
              <property name="value"><double>1.0</double></property>
              <property name="toolTip"><string>Signal value at the peak of each ramp cycle</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel">
              <property name="text"><string>← peak value</string></property>
              <property name="styleSheet"><string>color: #aaa; font-size: 10px;</string></property>
             </widget>
            </item>
           </layout>
          </item>

          <item row="2" column="0">
           <widget class="QLabel"><property name="text"><string>Rise Time (ms):</string></property></widget>
          </item>
          <item row="2" column="1">
           <layout class="QHBoxLayout">
            <item>
             <widget class="QDoubleSpinBox" name="spinRampRise">
              <property name="minimum"><double>1.0</double></property>
              <property name="maximum"><double>1e+08</double></property>
              <property name="decimals"><number>1</number></property>
              <property name="singleStep"><double>100.0</double></property>
              <property name="value"><double>1000.0</double></property>
              <property name="toolTip"><string>Time to linearly travel from Start Value to End Value</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel">
              <property name="text"><string>← start → end duration</string></property>
              <property name="styleSheet"><string>color: #aaa; font-size: 10px;</string></property>
             </widget>
            </item>
           </layout>
          </item>

          <item row="3" column="0">
           <widget class="QLabel"><property name="text"><string>Hold Time (ms):</string></property></widget>
          </item>
          <item row="3" column="1">
           <layout class="QHBoxLayout">
            <item>
             <widget class="QDoubleSpinBox" name="spinRampHold">
              <property name="minimum"><double>0.0</double></property>
              <property name="maximum"><double>1e+08</double></property>
              <property name="decimals"><number>1</number></property>
              <property name="singleStep"><double>100.0</double></property>
              <property name="value"><double>0.0</double></property>
              <property name="toolTip"><string>Time to hold at End Value before resetting. Set 0 for instant sawtooth reset.</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel">
              <property name="text"><string>← hold at peak (0 = instant reset)</string></property>
              <property name="styleSheet"><string>color: #aaa; font-size: 10px;</string></property>
             </widget>
            </item>
           </layout>
          </item>

          <item row="4" column="0">
           <widget class="QLabel"><property name="text"><string>Cycle (ms):</string></property></widget>
          </item>
          <item row="4" column="1">
           <widget class="QLabel" name="lblRampCycle">
            <property name="text"><string>1000.0 ms  (Rise + Hold)</string></property>
            <property name="styleSheet"><string>color: #aaa; font-style: italic;</string></property>
           </widget>
          </item>

         </layout>
        </widget>
       </item>
      </layout>
     </widget>

    </widget><!-- /QStackedWidget -->
   </item>

   <!-- ── Preview ───────────────────────────────────────── -->
   <item>
    <widget class="QWidget" name="previewContainer">
     <property name="minimumHeight"><number>140</number></property>
    </widget>
   </item>

   <!-- ── Footer buttons ────────────────────────────────── -->
   <item>
    <layout class="QHBoxLayout" name="hlButtons">
     <item>
      <widget class="QPushButton" name="btnApplyToAll">
       <property name="text"><string>Apply Settings to All Signals</string></property>
       <property name="toolTip"><string>Copy current waveform settings to every signal in this message</string></property>
      </widget>
     </item>
     <item>
      <spacer>
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QDialogButtonBox" name="buttonBox">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="standardButtons"><set>QDialogButtonBox::Ok|QDialogButtonBox::Cancel</set></property>
      </widget>
     </item>
    </layout>
   </item>

  </layout>
 </widget>
 <resources/>
 <connections>
  <connection>
   <sender>buttonBox</sender><signal>accepted()</signal>
   <receiver>WaveformDialog</receiver><slot>accept()</slot>
   <hints><hint type="sourcelabel"><x>300</x><y>530</y></hint><hint type="destinationlabel"><x>290</x><y>280</y></hint></hints>
  </connection>
  <connection>
   <sender>buttonBox</sender><signal>rejected()</signal>
   <receiver>WaveformDialog</receiver><slot>reject()</slot>
   <hints><hint type="sourcelabel"><x>300</x><y>530</y></hint><hint type="destinationlabel"><x>290</x><y>280</y></hint></hints>
  </connection>
 </connections>
</ui>
